---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="min-h-screen bg-slate-950 px-6 py-24 text-white">
		<div class="mx-auto max-w-4xl">
			<nav class="mb-10">
				<a class="text-sky-300 hover:text-sky-200" href="/">Back home</a>
			</nav>
			<h1 class="text-5xl font-bold tracking-tight">Projects</h1>
			<p class="mt-6 max-w-2xl text-lg text-slate-300">
				This is your projects page. Replace this with featured work, case studies, or links to
				repositories.
			</p>
		</div>
	</main>
</Layout>
