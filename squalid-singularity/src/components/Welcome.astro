---
import "../styles/global.css";
---

<div id="container">
	<nav
		class="fixed top-6 left-0 z-2 flex w-full justify-center gap-10 px-5 py-3 md:top-4 md:gap-6 md:px-3.5 md:py-2.5"
		aria-label="Primary"
	>
		<a
			class="inline-flex items-center justify-center text-sm uppercase tracking-[0.08em] text-gray-600 transition-colors hover:text-sky-300"
			href="/"
		>
			Home
		</a>
		<a
			class="inline-flex items-center justify-center text-sm uppercase tracking-[0.08em] text-gray-600 transition-colors hover:text-sky-300"
			href="/projects"
		>
			Projects
		</a>
		<a
			class="inline-flex items-center justify-center text-sm uppercase tracking-[0.08em] text-gray-600 transition-colors hover:text-sky-300"
			href="#about"
		>
			About Me
		</a>
	</nav>
	<main>
		<section id="hero">
			<div class="relative inline-block">
				<div class="text-[clamp(5rem,32vw,55rem)] font-extrabold leading-none text-sky-300/10">
					MILO
				</div>
				<div class="absolute inset-0 grid place-items-center">
					<div class="relative flex min-h-36 w-full items-center justify-center px-6">
						<ul
							id="role-list"
							class="flex max-w-3xl flex-wrap justify-center gap-x-6 gap-y-2 text-center text-xs font-medium uppercase tracking-[0.18em] text-sky-900 sm:text-sm lg:absolute lg:left-8 lg:top-1/2 lg:max-w-none lg:-translate-y-1/2 lg:flex-col lg:items-start lg:gap-3 lg:pl-10 lg:text-left"
						>
							<span
								id="role-arrow"
								class="absolute left-0 top-0 hidden text-base font-semibold normal-case tracking-normal text-sky-700 transition-transform duration-200 ease-out lg:block"
								aria-hidden="true"
							>
								-&gt;
							</span>
							<li data-role-item class="cursor-pointer hover:font-semibold">Machine Learning Engineer</li>
							<li data-role-item class="cursor-pointer hover:font-semibold">Physicist</li>
							<li data-role-item class="cursor-pointer hover:font-semibold">Independent Researcher</li>
						</ul>
						<div class="flex min-h-36 items-center justify-center px-6 font-[Georgia] text-[clamp(4rem,13vw,8rem)] text-sky-800">
							Milo Coombs
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
	<section id="about">
		<div class="about-inner">
			<p class="about-kicker">About Me</p>
			<h2>Placeholder section for your introduction, background, and current work.</h2>
			<p>
				This can become the homepage summary of who you are, what you work on, and the themes you
				want search engines and visitors to understand first.
			</p>
			<p>
				Later, you can keep this concise and link outward to more detailed project, research, or CV
				pages.
			</p>
		</div>
	</section>
</div>

<script>
	const roleList = document.querySelector<HTMLUListElement>('#role-list');
	const roleArrow = document.querySelector<HTMLSpanElement>('#role-arrow');
	const roleItems = roleList
		? Array.from(roleList.querySelectorAll<HTMLLIElement>('[data-role-item]'))
		: [];

	const moveArrowTo = (item: HTMLLIElement | undefined) => {
		if (!roleArrow || !item || window.innerWidth < 1024) return;

		const y = item.offsetTop + item.offsetHeight / 2 - roleArrow.offsetHeight / 2;
		roleArrow.style.transform = `translateY(${y}px)`;
	};

	if (roleList && roleArrow && roleItems.length > 0) {
		moveArrowTo(roleItems[0]);

		roleItems.forEach((item) => {
			item.addEventListener('pointerenter', () => moveArrowTo(item));
		});

		window.addEventListener('resize', () => {
			const hoveredItem = roleItems.find((item) => item.matches(':hover')) ?? roleItems[0];
			moveArrowTo(hoveredItem);
		});
	}
</script>

<style>
	html {
		scroll-behavior: smooth;
	}

	#container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		min-height: 100vh;
	}

	main {
		min-height: 100vh;
		display: flex;
		justify-content: center;
		background:
			linear-gradient(to top, rgba(94, 197, 245, 0.9) 0%, rgba(224, 242, 254, 0.7) 40%, #ffffff 100%);
	}

	#hero {
		display: flex;
		align-items: start;
		flex-direction: column;
		justify-content: center;
		padding: 16px;
	}

	#about {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 8rem 1.5rem 6rem;
		background:
			linear-gradient(to bottom, rgba(94, 197, 245, 0.9) 0%, rgba(224, 242, 254, 0.7) 40%, #ffffff 100%);
	}

	.about-inner {
		max-width: 52rem;
		color: #0f172a;
	}

	.about-kicker {
		margin: 0 0 1rem;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: #075985;
	}

	.about-inner h2 {
		margin: 0 0 1.5rem;
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		line-height: 1.05;
		color: #0f172a;
	}

	.about-inner p {
		max-width: 42rem;
		font-size: 1.125rem;
		line-height: 1.8;
		color: #334155;
	}

	.about-inner p + p {
		margin-top: 1rem;
	}

	#links {
		display: flex;
		gap: 16px;
	}

	#links a {
		display: flex;
		align-items: center;
		padding: 10px 12px;
		color: #111827;
		text-decoration: none;
		transition: color 0.2s;
	}

	#links a:hover {
		color: rgb(78, 80, 86);
	}

	#links a svg {
		height: 1em;
		margin-left: 8px;
	}

	#links a.button {
		color: white;
		background: linear-gradient(83.21deg, #3245ff 0%, #bc52ee 100%);
		box-shadow:
			inset 0 0 0 1px rgba(255, 255, 255, 0.12),
			inset 0 -2px 0 rgba(0, 0, 0, 0.24);
		border-radius: 10px;
	}

	#links a.button:hover {
		color: rgb(230, 230, 230);
		box-shadow: none;
	}

	pre {
		font-family:
			ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, 'DejaVu Sans Mono',
			monospace;
		font-weight: normal;
		background: linear-gradient(14deg, #d83333 0%, #f041ff 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin: 0;
	}

	h2 {
		margin: 0 0 1em;
		font-weight: normal;
		color: #111827;
		font-size: 20px;
	}

	p {
		color: #4b5563;
		font-size: 16px;
		line-height: 24px;
		letter-spacing: -0.006em;
		margin: 0;
	}

	code {
		display: inline-block;
		background:
			linear-gradient(66.77deg, #f3cddd 0%, #f5cee7 100%) padding-box,
			linear-gradient(155deg, #d83333 0%, #f041ff 18%, #f5cee7 45%) border-box;
		border-radius: 8px;
		border: 1px solid transparent;
		padding: 6px 8px;
	}

	.box {
		padding: 16px;
		background: rgba(255, 255, 255, 1);
		border-radius: 16px;
		border: 1px solid white;
	}

	#news {
		position: absolute;
		bottom: 16px;
		right: 16px;
		max-width: 300px;
		text-decoration: none;
		transition: background 0.2s;
		backdrop-filter: blur(50px);
	}

	#news:hover {
		background: rgba(255, 255, 255, 0.55);
	}

	@media screen and (max-height: 368px) {
		#news {
			display: none;
		}
	}

	@media screen and (max-width: 768px) {
		#container {
			display: flex;
			flex-direction: column;
		}

		#hero {
			display: block;
			padding-top: 10%;
		}

		#about {
			padding-top: 6rem;
		}

		.about-inner h2 {
			font-size: clamp(2rem, 10vw, 3rem);
		}

		#links {
			flex-wrap: wrap;
		}

		#links a.button {
			padding: 14px 18px;
		}

		#news {
			right: 16px;
			left: 16px;
			bottom: 2.5rem;
			max-width: 100%;
		}
	}
</style>
